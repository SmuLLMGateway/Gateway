COMPOSE_PROJECT_NAME=llm-gateway
GATEWAY_NETWORK_NAME=llm-gateway-network
BIND_ADDRESS=127.0.0.1

GATEWAY_PORT=3000
APP_NAME=llm-gateway

JWT_SECRET=local-jwt-secret-change-this-value-32-characters
# `openssl rand -base64 32`로 생성하고 운영 환경에서는 Secret Manager로 주입합니다.
API_KEY_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=local-mysql-root-password
DB_USERNAME=gateway
DB_PASSWORD=local-mysql-gateway-password
DB_NAME=llm_gateway

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=gateway-local
MINIO_ROOT_PASSWORD=local-minio-secret-password
MINIO_BUCKET=llm-gateway-private
MINIO_REGION=us-east-1
MINIO_PRESIGNED_GET_TTL_SECONDS=600

# NER가 호스트에서 실행되면 localhost, 같은 Docker network면 minio를 사용합니다.
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false

# 호스트에서 실행 중인 NER 서버를 Gateway 컨테이너가 호출하는 주소입니다.
NER_SERVER_IP=host.docker.internal
NER_SERVER_PORT=8000
NER_DEPLOYMENT_ID=
NER_LLM_DEPLOYMENT_ID=
PROVIDER_SERVER_IP=host.docker.internal
PROVIDER_SERVER_PORT=8001
NER_CALLBACK_SECRET=local-ner-callback-secret
