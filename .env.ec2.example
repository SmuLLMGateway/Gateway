# Docker Compose (EC2) - 이 파일을 .env.ec2로 복사한 뒤 실제 비밀값으로 교체합니다.
COMPOSE_PROJECT_NAME=llm-gateway
GATEWAY_NETWORK_NAME=llm-gateway-network

APP_NAME=llm-gateway
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_PORT=3000

# EC2 호스트에 설치된 MySQL 접속 정보입니다.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=gateway
DB_PASSWORD=change-this-database-password
DB_NAME=llm_gateway

# 32바이트 이상의 무작위 값으로 교체합니다.
JWT_SECRET=change-this-jwt-secret-to-a-random-32-byte-value
API_KEY_ENCRYPTION_KEY=change-this-api-key-encryption-key
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# MinIO API와 Console은 기본적으로 EC2 내부에만 노출합니다.
MINIO_API_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_VOLUME_NAME=minio-data
MINIO_ROOT_USER=gateway-minio
MINIO_ROOT_PASSWORD=change-this-minio-root-password
MINIO_BUCKET=llm-gateway-private
MINIO_REGION=ap-northeast-2
MINIO_PRESIGNED_GET_TTL_SECONDS=600

# NER가 같은 EC2 호스트에서 실행될 때의 설정입니다.
NER_SERVER_IP=host.docker.internal
NER_SERVER_PORT=8000
NER_DEPLOYMENT_ID=
NER_LLM_DEPLOYMENT_ID=
PROVIDER_SERVER_IP=host.docker.internal
PROVIDER_SERVER_PORT=8001
NER_CALLBACK_SECRET=change-this-ner-callback-secret

# NER가 같은 EC2 호스트에 있으면 127.0.0.1을 유지합니다.
# NER가 다른 EC2에 있으면, 그 서버에서 도달 가능한 MinIO의 private DNS 또는 IP로 변경하고
# MINIO_API_BIND_ADDRESS와 보안 그룹도 그 서버에 한해 열어야 합니다.
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=9000
MINIO_PUBLIC_USE_SSL=false
